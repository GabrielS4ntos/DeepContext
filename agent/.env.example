DEEPCONTEXT_CHAT_MODEL=openai:gpt-4.1-mini
DEEPCONTEXT_EMBEDDING_MODEL=openai:text-embedding-3-small
OPENAI_API_KEY=replace-me

DEEPCONTEXT_QDRANT_URL=http://qdrant:6333
DEEPCONTEXT_QDRANT_API_KEY=
DEEPCONTEXT_QDRANT_COLLECTION=deepcontext
DEEPCONTEXT_QDRANT_VECTOR_NAME=
DEEPCONTEXT_QDRANT_TEXT_FIELD=page_content
DEEPCONTEXT_QDRANT_SOURCE_FIELD=source
DEEPCONTEXT_QDRANT_SOURCE_ID_FIELD=source_id

DEEPCONTEXT_WEB_SEARCH_ENABLED=true
DEEPCONTEXT_WEB_SEARCH_API_KEY=
DEEPCONTEXT_WEB_SEARCH_MODEL=openai/gpt-4.1-mini

OTEL_SDK_DISABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=deepcontext-agent
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

